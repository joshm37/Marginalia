{
  "name": "marginalia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "extension:build": "node scripts/build-extension.mjs --production",
    "extension:build:dev": "node scripts/build-extension.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:rename-excerpts": "prisma db execute --file prisma/rename-annotations-to-excerpts.sql",
    "db:remove-quote-type": "prisma db execute --file prisma/remove-quote-excerpt-type.sql",
    "db:add-bibliography-annotation": "prisma db execute --file prisma/add-source-bibliography-annotation.sql",
    "db:add-bibliography-toggle": "prisma db execute --file prisma/add-source-bibliography-toggle.sql",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@citation-js/core": "^0.8.2",
    "@citation-js/plugin-csl": "^0.8.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "cheerio": "^1.2.0",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "jspdf": "^4.2.1",
    "lucide-react": "0.468.0",
    "next": "^16.3.4",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
