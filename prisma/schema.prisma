generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SourceType {
  ARTICLE
  REPORT
  CASE
  BILL
  BOOK
  WEBSITE
}

enum CaptureMethod {
  EXTENSION
  MANUAL
  IMPORT
}

enum SourceStorageMode {
  WEB
  LOCAL
  ARCHIVED
}

enum ContributorRole {
  AUTHOR
  EDITOR
  TRANSLATOR
}

enum ExcerptType {
  EVIDENCE
  SUMMARY
  QUESTION
  COUNTERARGUMENT
  NOTE
}

model User {
  id           String        @id
  // Contact snapshot only. Supabase ID, never email, determines ownership.
  email        String
  displayName  String?
  sources      Source[]
  projects     Project[]
  tags         Tag[]
  excerpts     Excerpt[]
  contributors Contributor[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Source {
  id                     String              @id @default(cuid())
  userId                 String
  user                   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                  String
  authors                String?
  organization           String?
  publicationDate        DateTime?
  sourceType             SourceType
  url                    String?
  canonicalUrl           String?
  normalizedUrl          String?
  doi                    String?
  description            String?
  bibliographyAnnotation String?
  includeInBibliography  Boolean             @default(true)
  notes                  String?
  citationMetadata       Json?
  containerTitle         String?
  volume                 String?
  issue                  String?
  pages                  String?
  publisher              String?
  publisherPlace         String?
  edition                String?
  isbn                   String?
  issn                   String?
  accessedDate           DateTime?
  language               String?
  captureMethod          CaptureMethod       @default(MANUAL)
  metadataNeedsReview    Boolean             @default(false)
  fileUrl                String?
  storageMode            SourceStorageMode   @default(WEB)
  localFile              LocalFileReference?
  projects               ProjectSource[]
  tags                   SourceTag[]
  excerpts               Excerpt[]
  contributors           SourceContributor[]
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@unique([userId, doi])
  @@unique([userId, canonicalUrl])
  @@unique([userId, normalizedUrl])
  @@unique([id, userId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, sourceType])
  @@index([userId, containerTitle])
}

model LocalFileReference {
  sourceId     String   @unique
  userId       String
  sha256       String   @db.Char(64)
  filename     String
  fileSize     BigInt
  mimeType     String
  lastModified DateTime?
  source       Source   @relation(fields: [sourceId, userId], references: [id, userId], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@id([sourceId, userId])
  @@unique([userId, sha256])
  @@index([sha256])
}

model Contributor {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  given     String?
  family    String?
  literal   String?
  suffix    String?
  isLegacy  Boolean             @default(false)
  sources   SourceContributor[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([userId, family, given])
  @@index([userId, literal])
}

model SourceContributor {
  sourceId      String
  contributorId String
  role          ContributorRole
  sequence      Int
  source        Source          @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  contributor   Contributor     @relation(fields: [contributorId], references: [id], onDelete: Cascade)

  @@id([sourceId, contributorId, role])
  @@unique([sourceId, role, sequence])
  @@index([contributorId])
}

model Project {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  color       String?
  archivedAt  DateTime?
  isActive    Boolean          @default(true)
  deletedAt   DateTime?
  sources     ProjectSource[]
  excerpts    ExcerptProject[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([userId, name])
  @@index([userId, updatedAt(sort: Desc)])
  @@index([userId, deletedAt, isActive])
}

model Tag {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String?
  sources   SourceTag[]
  excerpts  ExcerptTag[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([userId, name])
}

model Excerpt {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceId        String
  source          Source           @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  selectedText    String
  surroundingText String?
  note            String?
  pageUrl         String?
  excerptType     ExcerptType
  locationData    Json?
  projects        ExcerptProject[]
  tags            ExcerptTag[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([sourceId, createdAt(sort: Desc)])
}

model ProjectSource {
  projectId String
  sourceId  String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source    Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  addedAt   DateTime @default(now())

  @@id([projectId, sourceId])
  @@index([sourceId])
}

model SourceTag {
  sourceId String
  tagId    String
  source   Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([sourceId, tagId])
  @@index([tagId])
}

model ExcerptProject {
  excerptId String
  projectId String
  excerpt   Excerpt @relation(fields: [excerptId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([excerptId, projectId])
  @@index([projectId])
}

model ExcerptTag {
  excerptId String
  tagId     String
  excerpt   Excerpt @relation(fields: [excerptId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([excerptId, tagId])
  @@index([tagId])
}

model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}
