# Public Supabase project configuration. These values are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your-key"

# Server-only Supabase key used exclusively for confirmed account deletion.
# Never prefix this value with NEXT_PUBLIC_ or include it in the extension.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Public beta support address shown in Settings.
NEXT_PUBLIC_SUPPORT_EMAIL="support@example.com"

# Secret PostgreSQL connection string. Use Supabase's pooled connection for Vercel.
DATABASE_URL="postgresql://user:password@host:6543/postgres"

# Optional but recommended: identifies this app to Crossref's polite API pool.
CROSSREF_MAILTO="you@example.com"
# Maximum PDF size processed locally in the browser (bytes are never uploaded).
NEXT_PUBLIC_MAX_LOCAL_PDF_MB=512
