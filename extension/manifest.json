{
  "manifest_version": 3,
  "name": "Research & Citation Manager",
  "version": "0.1.0",
  "description": "Capture sources and selected passages into your research library.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": { "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
